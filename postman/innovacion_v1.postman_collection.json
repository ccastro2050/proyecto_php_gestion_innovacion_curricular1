          "raw": "{\n  \"razon_social\": \"Empresa de Ejemplo\",\n  \"nombre_contacto\": \"Ana Ruiz\",\n  \"correo\": \"contacto@empresa.example.com\",\n  \"telefono\": \"+57 604 555 0199\",\n  \"ciudad\": \"Medellin\"\n}"
